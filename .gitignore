# Secrets — never commit; contains SECRET_KEY and DB passwords
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
env/
venv/
.venv/

# Django
db.sqlite3
db.sqlite3-journal
db.sqlite3-shm
db.sqlite3-wal
staticfiles/

# User uploads (banner photos, bills) — belongs in backups, not git
media/

# IDE / editor
.vscode/
.idea/
*.swp

# Claude Code — settings.local.json holds this machine's own tool
# permissions, not something to share via git (settings.json, if ever
# added, is the project-shared one and stays tracked).
.claude/settings.local.json

# Test artifacts
.pytest_cache/
.coverage

# OS files
Thumbs.db
.DS_Store

# Logs
*.log
